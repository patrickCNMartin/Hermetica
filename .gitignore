# Hermetica — .gitignore
# --- Secrets ----------------------------------------------------------------
.env
.env.*
*.env


# --- Real protocol data -----------------------------------------------------
db/
logs/


# just in case there are some protocol lock files 
*.lock
!flake.lock
!uv.lock

# Rendered protocols and scanned lab documents.
*.pdf
*.db

# --- Working notes ----------------------------------------------------------
docs/*
!docs/audit_log.md
protocol_io_bundle/
protocol_io_bundle.tar.gz

# --- Agent stuff  ----------------------------------------------------------

.continue/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
